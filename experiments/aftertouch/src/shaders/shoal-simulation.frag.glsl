precision highp float;
uniform sampler2D u_state;
uniform sampler2D u_velocity;
uniform mat4 u_view_projection;
uniform vec3 u_camera_right;
uniform vec3 u_camera_up;
uniform vec3 u_to_viewer;
uniform float u_projection_scale;
uniform float u_aspect;
uniform float u_time;
uniform float u_dt;
uniform float u_turbulence;
uniform float u_decay;
uniform float u_particle_attraction;
uniform vec2 u_pointer;
uniform vec2 u_pointer_previous;
uniform vec2 u_pointer_velocity;
uniform float u_active;
in vec2 v_uv;
layout(location = 0) out vec4 out_position;
layout(location = 1) out vec4 out_velocity;
float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
void main() {
  vec3 p = texture(u_state, v_uv).xyz;
  vec3 velocity = texture(u_velocity, v_uv).xyz;
  float seed = hash(v_uv);
  float heightSeed = hash(v_uv + 7.31);
  float preferredY = (heightSeed * 2.0 - 1.0) * 0.98;
  float radius = max(length(p.xz), 0.001);
  vec3 radial = vec3(p.x / radius, 0.0, p.z / radius);
  vec3 tangent = vec3(-radial.z, 0.0, radial.x);
  float angle = atan(p.z, p.x);
  float level = clamp((p.y + 1.0) * 0.5, 0.0, 1.0);
  float band = 0.30 + level * 0.37 + seed * 0.12;
  band += 0.045 * sin(angle * 2.0 - p.y * 2.6 + u_time * 0.18);
  vec3 field = tangent * (0.24 + seed * 0.14 + u_turbulence * 0.035);
  field += radial * (band - radius) * 0.85;
  field.y = (preferredY - p.y) * 0.42 + 0.13 * sin(angle - p.y * 2.0 + seed * 6.2831853);
  field += vec3(sin(p.z * 4.0 + u_time * 0.27), sin(p.x * 3.0 - u_time * 0.2), cos(p.y * 4.0 + u_time * 0.23)) * (0.012 + u_turbulence * 0.013);
  vec4 clip = u_view_projection * vec4(p, 1.0);
  vec2 screen = clip.xy / max(clip.w, 0.01);
  screen.x *= u_aspect;
  vec2 stroke = u_pointer - u_pointer_previous;
  float along = clamp(dot(screen - u_pointer_previous, stroke) / max(dot(stroke, stroke), 0.00001), 0.0, 1.0);
  vec2 toward = mix(u_pointer_previous, u_pointer, along) - screen;
  float distanceToTouch = length(toward);
  vec3 direction = (u_camera_right * toward.x + u_camera_up * toward.y) / max(distanceToTouch, 0.02);
  float swipeSpeed = length(u_pointer_velocity);
  float brushing = smoothstep(0.15, 1.1, swipeSpeed);
  float brushRadius = 0.8 * mix(0.18, 0.30, smoothstep(0.2, 6.0, swipeSpeed));
  float front = mix(0.25, 1.0, smoothstep(-0.5, 0.5, dot(p, u_to_viewer)));
  float influence = exp(-distanceToTouch * distanceToTouch / (brushRadius * brushRadius)) * u_active * front;
  float burst = smoothstep(1.6, 2.8, u_particle_attraction);
  float orbit = 1.0 - smoothstep(0.08, 0.4, abs(u_particle_attraction - 0.5));
  vec3 touchForce = direction * u_particle_attraction * (1.0 - burst) * 0.6;
  touchForce -= direction * burst * 2.0;
  touchForce += cross(u_to_viewer, direction) * orbit * 0.6;
  field += touchForce * influence * (1.0 - brushing * 0.9);
  vec3 comb = (u_camera_right * u_pointer_velocity.x + u_camera_up * u_pointer_velocity.y) * clip.w / u_projection_scale;
  comb *= min(1.0, 3.4 / max(length(comb), 0.001));
  float combing = min(influence * brushing, 0.98);
  field = mix(field, comb + field * 0.06, combing);
  velocity = mix(velocity, field, min(1.0, u_dt * (4.0 + combing * 22.0)));
  velocity *= pow(u_decay, u_dt * 20.0);
  p += velocity * u_dt;
  if (length(p) > 2.8) {
    float theta = seed * 6.2831853 + u_time * 0.14;
    float r = 0.30 + heightSeed * 0.37 + seed * 0.12;
    p = vec3(cos(theta) * r, preferredY, sin(theta) * r);
    velocity = vec3(0.0);
  }
  out_position = vec4(p, 1.0);
  out_velocity = vec4(velocity, 1.0);
}
