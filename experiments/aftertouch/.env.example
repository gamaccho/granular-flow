# Server only. Never use a VITE_ prefix for this key.
TYPESAFE_API_KEY=your_key_here
PORT=3000
JEV_MODEL=jev-latest
JEV_MOCK=false
# Comma-separated extra browser origins, only if hosting frontend separately.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set only behind a trusted reverse proxy (e.g. 1 for exactly one hop).
TRUST_PROXY=false
