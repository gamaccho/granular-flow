{
  "name": "aftertouch-webgl-jev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "concurrently -k -n proxy,art \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.7"
  }
}
